.DS_Store

# Rust (scripts default CARGO_TARGET_DIR outside the repo; this catches plain cargo runs)
/core/target/

# scripts/build-xcframework.sh output
/Packages/MdCore/DewlineFFI.xcframework/
/Packages/MdCore/Sources/DewlineFFIBindings/

# XcodeGen output: regenerate with `xcodegen generate --spec app/project.yml`. Package.resolved stays: it pins
# every Swift package's revision, and release builds resolve only from it.
/app/Dewline.xcodeproj/*
!/app/Dewline.xcodeproj/project.xcworkspace/
/app/Dewline.xcodeproj/project.xcworkspace/*
!/app/Dewline.xcodeproj/project.xcworkspace/xcshareddata/
/app/Dewline.xcodeproj/project.xcworkspace/xcshareddata/*
!/app/Dewline.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
/app/Dewline.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!/app/Dewline.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
/app/Dewline/Info.plist
/app/Dewline/Dewline.entitlements
/app/QuickLook/Info.plist
/app/QuickLook/DewlinePreview.entitlements

# Xcode
/build/
DerivedData/
xcuserdata/
*.xcuserstate
